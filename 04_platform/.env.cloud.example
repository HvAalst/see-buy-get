# SeeBuyGet — settings for the Docker stack ON A SERVER (production). On a laptop use .env.local.example.
#
#   cp .env.cloud.example .env
#
# .env is never committed (.gitignore). Every line here reaches the API container; the first block also shapes the
# web container and its build. For what each backend setting does, see .env.example beside this file.

# The shared stack plus the server's part of it (ports 80/443, production mode, log rotation).
COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml

# --- 1. Where it lives -----------------------------------------------------------------------------------------------
# Both domains must point (DNS A record) at the Droplet before the first start, or Caddy cannot get certificates.
SBG_PUBLIC_URL=https://seebuyget.com
SBG_CONSOLE_URL=https://ops.seebuyget.com

# What stands in front of the Droplet:
#   cloudflare  DNS on Cloudflare with the proxy on (orange cloud). Certificates come by DNS challenge, so Caddy needs
#               a Cloudflare API token: My Profile → API Tokens → Create Token → "Edit zone DNS", for this zone only.
#               Set SSL/TLS to "Full (strict)" in Cloudflare. See DEPLOY.md, "Behind Cloudflare".
#   direct      nothing: the domain's A records point straight at the Droplet (or Cloudflare with the grey cloud).
CADDY_EDGE=cloudflare
CLOUDFLARE_API_TOKEN=

# Who may load the operator console at all (space-separated addresses or ranges). Unset: anyone.
# CONSOLE_ALLOW_IPS=203.0.113.10/32 198.51.100.0/24

# Where built images are pushed to and pulled from, when they are built somewhere other than the Droplet
# (e.g. DigitalOcean Container Registry). Unset: images are built on the server itself.
# REGISTRY=registry.digitalocean.com/<your-registry>
# TAG=latest

# --- 2. The secrets the API will not start without -------------------------------------------------------------------
# Each its own value:  openssl rand -hex 32
# The two peppers and the vault key must NEVER change once real data exists: changing one re-keys what is stored.
GLOS_AUTH_SECRET=
GLOS_VAULT_KEY=
GLOS_PHONE_PEPPER=
GLOS_IDENTITY_PEPPER=
GLOS_FUNDING_SECRET=
GLOS_LABEL_KEY=
GLOS_DISCLOSURE_KEY=
GLOS_VAPID_PRIVATE=
# The console's setup key: makes the first member of network staff. Same command.
GLOS_CLIENT_SECRET=

# --- 3. Who may reach it ---------------------------------------------------------------------------------------------
# GLOS_STAFF_NETWORKS=
# GLOS_VAPID_SUBJECT=mailto:ops@seebuyget.com
# Extra sites of ours that call the API from a browser, comma-separated (the two above are already allowed).
# GLOS_CORS_ORIGINS=

# --- 4. Texts: Twilio (without it nobody can sign up or reset a PIN) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM=

# --- 5. Email: ZeptoMail (staff beyond the first are invited by email) ----------------------------------------------
# ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_URL=
# ZEPTOMAIL_WEBHOOK_KEY=
# MAIL_FROM_ADDRESS=

# --- 6. Optional ----------------------------------------------------------------------------------------------------
# An OSRM-compatible routing server for road distances.
# GLOS_ROUTER_URL=
