# SeeBuyGet — settings for the Docker stack ON A LAPTOP. On a server use .env.cloud.example.
#
#   cp .env.local.example .env
#   docker compose up -d --build
#   docker compose exec api node scripts/seed-demo.mjs     # demo data + the sign-in sheet
#
# The API runs as a sandbox: no secrets are needed (it uses the values printed in the source), no text is sent (a
# one-time code is shown on screen), and the contract is served at http://localhost:3000/v1/docs.

# The shared stack plus the laptop's part of it (localhost ports, sandbox mode).
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Caddy serves each address on the port it names. Change a port here and in docker-compose.local.yml together.
SBG_PUBLIC_URL=http://localhost:8080
SBG_CONSOLE_URL=http://localhost:8081
