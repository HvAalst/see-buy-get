# SeeBuyGet edge — two sites, each named by its full address.
#
#   SBG_PUBLIC_URL   the public site: the front door at /, each app under its own path, the API under /v1
#   SBG_CONSOLE_URL  the operator console, alone on its own address (see frontend/README.md, "The operator
#                    console's entrance"); CONSOLE_ALLOW_IPS narrows who may load it at all
#   CADDY_EDGE       what stands in front of this server: `direct` (nothing — a laptop, or a server the world reaches
#                    itself) or `cloudflare` (Cloudflare's proxy, the orange cloud)
#
# An http:// address (a laptop, http://localhost:8080) is served as is, on the port it names. An https:// address gets
# a certificate Caddy obtains and renews on its own: `direct`, by Let's Encrypt reaching this server; `cloudflare`,
# by a DNS record Caddy writes through Cloudflare's API (CLOUDFLARE_API_TOKEN), because Let's Encrypt cannot reach a
# server behind the proxy. The values come from .env, through docker-compose.yml.

# WHO IS ASKING. `direct`: whoever opened the connection, and no header is believed. `cloudflare`: every connection
# comes from Cloudflare, so the visitor's address is read from the header Cloudflare sets — believed only from
# Cloudflare's own address ranges (fetched from Cloudflare and kept current), never from anybody else.
(global_direct) {
}

(global_cloudflare) {
	servers {
		trusted_proxies cloudflare
		client_ip_headers CF-Connecting-IP
	}
}

{
	import global_{$CADDY_EDGE}
}

(tls_direct) {
}

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Vite fingerprints everything under <app>/assets/, so those may be kept forever. Everything else — the pages, the
# service workers, the manifests — is asked for again (and answered 304 when unchanged), or an installed app never
# learns there is a new version. Matched on what was ASKED for, before a deep link falls back to its app's
# index.html, which is why this is "not assets" rather than a list of page names.
(static_caching) {
	@hashed path */assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path */assets/*
	header @unhashed Cache-Control "no-cache"
}

{$SBG_PUBLIC_URL} {
	import tls_{$CADDY_EDGE}
	import security_headers
	encode zstd gzip

	# The API. Same origin as the apps, so they need no CORS. It is told the visitor's address and nothing else
	# (GLOS_TRUST_PROXY=1): whatever a visitor wrote in X-Forwarded-For themselves is dropped here.
	handle /v1/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv/site
		import static_caching

		@bare path_regexp ^/(driver|agent|send|fleet|mdp|vendor|business)$
		redir @bare {path}/ 308

		# Each app answers any path under its own base with its own shell.
		@app path_regexp app ^/(driver|agent|send|fleet|mdp|vendor|business)/
		handle @app {
			try_files {path} {path}/index.html /{re.app.1}/index.html
			file_server
		}

		# Everything else is the front door: prerendered town pages (/towns/<slug>/), help.html, and the
		# front door's own routes (a participant's page, /@handle).
		handle {
			try_files {path} {path}/index.html /index.html
			file_server
		}
	}
}

{$SBG_CONSOLE_URL} {
	import tls_{$CADDY_EDGE}
	import security_headers
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options DENY
	}

	# A stranger outside the allow-list gets nothing that says a console is here.
	@outside not client_ip {$CONSOLE_ALLOW_IPS}
	respond @outside 404

	encode zstd gzip
	root * /srv/console
	import static_caching
	try_files {path} /index.html
	file_server
}
