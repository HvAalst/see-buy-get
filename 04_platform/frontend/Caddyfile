# SeeBuyGet edge — two sites, each named by its full address.
#
#   SBG_PUBLIC_URL   the public site: the front door at /, each app under its own path, the API under /v1
#   SBG_CONSOLE_URL  the operator console, alone on its own address (see frontend/README.md, "The operator
#                    console's entrance"); CONSOLE_ALLOW_IPS narrows who may load it at all
#   CADDY_EDGE       what stands in front of this server: `direct` (nothing — a laptop, or a server the world reaches
#                    itself) or `cloudflare` (Cloudflare's proxy, the orange cloud)
#   SBG_REDIRECT_HOSTS  other names sent on to the public site (www.…), names with spaces between — `direct` only:
#                    behind Cloudflare its own redirect rule does this (DEPLOY.md)
#
# An http:// address (a laptop, http://localhost:8080) is served as is, on the port it names. An https:// address gets
# a certificate Caddy obtains and renews on its own: `direct`, by Let's Encrypt reaching this server; `cloudflare`,
# by a DNS record Caddy writes through Cloudflare's API (CLOUDFLARE_API_TOKEN), because Let's Encrypt cannot reach a
# server behind the proxy. The values come from .env, through docker-compose.yml.

# WHO IS ASKING. `direct`: whoever opened the connection, and no header is believed. `cloudflare`: every connection
# comes from Cloudflare, so the visitor's address is read from the header Cloudflare sets — believed only from
# Cloudflare's own address ranges (fetched from Cloudflare and kept current), never from anybody else.
(global_direct) {
}

(global_cloudflare) {
	servers {
		trusted_proxies cloudflare
		client_ip_headers CF-Connecting-IP
	}
}

{
	import global_{$CADDY_EDGE}
}

(tls_direct) {
}

# The record Caddy writes at Cloudflare is checked through Cloudflare's own resolvers, not the server's: a provider's
# resolver can keep a domain's old nameservers for a day or more after they change (found on the first release behind
# Cloudflare, 2026-10-22), and no certificate is issued until the check sees the record.
(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

# What the API is told about the visitor's country (the first guess for a phone number's country code, GET
# /v1/sbg/visitor). Behind Cloudflare it is Cloudflare's own reading (CF-IPCountry), passed on as it came; without
# Cloudflare in front nobody's header is believed, so a CF-IPCountry a visitor wrote themselves is dropped here.
(api_edge_direct) {
	header_up -CF-IPCountry
}

(api_edge_cloudflare) {
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Vite fingerprints everything under <app>/assets/, so those may be kept forever. Everything else — the pages, the
# service workers, the manifests — is asked for again (and answered 304 when unchanged), or an installed app never
# learns there is a new version. Matched on what was ASKED for, before a deep link falls back to its app's
# index.html, which is why this is "not assets" rather than a list of page names.
(static_caching) {
	@hashed path */assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path */assets/*
	header @unhashed Cache-Control "no-cache"
}

# Asked by the container's own health check, from inside the container, and by nothing else.
http://127.0.0.1:9180 {
	bind 127.0.0.1
	respond "ok" 200
}

# THE OTHER NAMES PEOPLE TYPE for the public site — www, above all — sent on to the one address it has, with whatever
# came after the name. Each needs its own DNS record, and gets its own certificate. Unset, this answers a name nobody
# has.
{$SBG_REDIRECT_HOSTS:http://nobody.invalid:9181} {
	import security_headers
	redir {$SBG_PUBLIC_URL}{uri} 308
}

{$SBG_PUBLIC_URL} {
	import tls_{$CADDY_EDGE}
	import security_headers
	encode zstd gzip

	# The API. Same origin as the apps, so they need no CORS. It is told the visitor's address and nothing else
	# (GLOS_TRUST_PROXY=1): whatever a visitor wrote in X-Forwarded-For themselves is dropped here.
	handle /v1/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
			import api_edge_{$CADDY_EDGE}
		}
	}

	handle {
		root * /srv/site
		import static_caching

		@bare path_regexp ^/(driver|agent|send|fleet|mdp|vendor|business)$
		redir @bare {path}/ 308

		# A FILE ASKED FOR BY NAME THAT IS NOT THERE IS A 404 — never an app's page with a 200. After a release an
		# open app may still ask for a script the release replaced: handed a page, it fails on the first character;
		# told "not found", its service worker knows to fetch the new one.
		@gone {
			not file {path} {path}/
			path_regexp \.[A-Za-z0-9]+$
		}
		handle @gone {
			respond "Not found" 404
		}

		# Each app answers any path under its own base with its own shell.
		@app path_regexp app ^/(driver|agent|send|fleet|mdp|vendor|business)/
		handle @app {
			try_files {path} {path}/index.html /{re.app.1}/index.html
			file_server
		}

		# Everything else is the front door: prerendered town pages (/towns/<slug>/), help.html, and the
		# front door's own routes (a participant's page, /@handle).
		handle {
			try_files {path} {path}/index.html /index.html
			file_server
		}
	}
}

{$SBG_CONSOLE_URL} {
	import tls_{$CADDY_EDGE}
	import security_headers
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options DENY
	}

	# A stranger outside the allow-list gets nothing that says a console is here. The first of the handles below, so
	# that it comes before everything else on this address (handles are tried in the order they are written).
	@outside not client_ip {$CONSOLE_ALLOW_IPS}
	handle @outside {
		respond 404
	}

	handle {
		encode zstd gzip
		root * /srv/console
		import static_caching

		@gone {
			not file {path} {path}/
			path_regexp \.[A-Za-z0-9]+$
		}
		handle @gone {
			respond "Not found" 404
		}

		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
