<?xml version="1.0" encoding="utf-8"?>
<!--
    SeeBuyGet Driver (2026-11-02). Two parts: the Driver web app opened full screen as a Trusted Web Activity, and the
    car's part — the wake-up from Firebase, the notification Android Auto reads aloud, its Reply and Mark-as-read, and
    the link that turns it on (05_engineering/android-auto-messages.md).

    The car link's scheme and hosts below are the contract's, kept in Kotlin in car/CarContract.kt; CarLinkTest reads
    this file and fails when the two part.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 and up: asked when Messages in the car is turned on, or when the web app asks for notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11 and up: which installed browsers can open a Trusted Web Activity. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!--
        No backup and no device-to-device copy: the car key belongs to THIS phone (house rule: a key belongs to a
        device). A copy on another phone could not be opened anyway — its encryption key never leaves this one's
        keystore — but it is better not made.
    -->
    <application
        android:name=".DriverApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        tools:targetApi="31">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Android Auto: this app's notifications are messages the car may read aloud, and nothing else. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- No Firebase token is made until the driver turns Messages in the car on (Push.kt). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- The Driver web app, full screen. Opened with ?app=android, so the page knows it is inside this app. -->
        <activity
            android:name=".DriverLauncherActivity"
            android:alwaysRetainTaskState="true"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://${sbgHost}/driver/?app=android" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/sbg_navy" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/sbg_navy" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/sbg_navy" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="${applicationId}.fileprovider" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A link to the Driver app opens this app, once the site's assetlinks.json names it. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${sbgHost}"
                    android:pathPrefix="/driver"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
            THE CAR LINK: the web page's Settings › "Messages in the car" hands the car key over through
            sbgdriver://car-link?key=… (and takes it back with sbgdriver://car-unlink). Any app could open such a link;
            what it carries is checked for a car key's exact shape, and the key is tried against the server before the
            driver is told it is on.
        -->
        <activity
            android:name=".CarLinkActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/link_title"
            android:theme="@style/Theme.Driver.CarLink">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="car-link"
                    android:scheme="sbgdriver" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="car-unlink"
                    android:scheme="sbgdriver" />
            </intent-filter>
        </activity>

        <!-- The browser helper's own pieces, as Google's Bubblewrap declares them. -->
        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />
        <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- The web app's own notices (its bell, offers) shown as this app's, under its icon. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_stat_driver" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The wake-up: "this chat has news", never its words. -->
        <service
            android:name=".DriverMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reply and Mark as read, from the car or the phone's notification: in the background, no screen. -->
        <receiver
            android:name=".CarActionReceiver"
            android:exported="false" />
    </application>
</manifest>
