# .env example for GLOS sandbox
NODE_ENV=development

# --- Backend (04_generated_sandbox/backend) ---
# Port the NestJS API listens on (default 3000). API is served under /v1.
PORT=3000

# HMAC secret for the M6 auth shim token signing (T-006). CHANGE IN PRODUCTION.
GLOS_AUTH_SECRET=glos-dev-secret-change-me

# Key material for Identity Vault PII encryption, AES-256-GCM (T-003). CHANGE IN PRODUCTION.
# In production this is supplied by a KMS/HSM, not an env var.
GLOS_VAULT_KEY=glos-dev-vault-key-change-me

# --- Frontend (04_generated_sandbox/frontend) ---
# Optional: override the API base the onboarding wizard calls.
# Defaults to http://localhost:3000/v1. Set on window as GLOS_API to override at runtime.
