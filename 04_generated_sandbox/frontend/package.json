    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.13.0",
    "preact": "^10.29.7"
  },
  "overrides": {
    "vite": "^5.4.21"
  }
